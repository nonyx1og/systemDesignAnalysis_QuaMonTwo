@page
@model Friendship.Web.Pages.QuanLy.DuyetHuy.IndexModel
@{ ViewData["Title"] = "Duyệt phiếu hủy"; }
<h1 class="page-title">Duyệt phiếu hủy</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.NhapCuaToi.Count > 0)
{
    <h2 class="h5">Phiếu nháp của tôi (@Model.NhapCuaToi.Count)</h2>
    <div class="card-f p-0 mb-4">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Phiếu</th><th>Ngày lập</th><th class="text-end">Tổn thất</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in Model.NhapCuaToi)
        {
            <tr>
                <td data-label="Phiếu"><strong>@x.Ma</strong></td>
                <td data-label="Ngày lập">@Fmt.NgayGio(x.NgayLap)</td>
                <td data-label="Tổn thất" class="text-end">@Fmt.Tien(HuyHangService.TongTonThat(x))</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="GuiDuyet" asp-route-id="@x.Id" class="d-inline">
                        <button type="submit" class="btn btn-primary btn-sm">Gửi duyệt</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

<h2 class="h5">Chờ duyệt (@Model.ChoDuyet.Count)</h2>
@if (Model.ChoDuyet.Count == 0)
{
    <div class="card-f text-center mb-4">Không có phiếu nào chờ duyệt.</div>
}
else
{
    <div class="card-f p-0 mb-4">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Phiếu</th><th>Ngày lập</th><th>Người lập</th><th class="text-end">Tổn thất</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in Model.ChoDuyet)
        {
            <tr>
                <td data-label="Phiếu"><strong>@x.Ma</strong></td>
                <td data-label="Ngày lập">@Fmt.NgayGio(x.NgayLap)</td>
                <td data-label="Người lập">@x.NguoiLap.HoTen</td>
                <td data-label="Tổn thất" class="text-end">@Fmt.Tien(HuyHangService.TongTonThat(x))</td>
                <td class="text-end"><a asp-page="Detail" asp-route-id="@x.Id" class="btn btn-primary btn-sm">Xem và duyệt</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

<h2 class="h5">Đã xử lý gần đây</h2>
@if (Model.DaXuLy.Count == 0)
{
    <div class="card-f text-center">Chưa có phiếu nào được xử lý.</div>
}
else
{
    <div class="card-f p-0">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Phiếu</th><th>Người lập</th><th>Người duyệt</th><th>Ngày xử lý</th><th class="text-end">Tổn thất</th><th>Kết quả</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in Model.DaXuLy)
        {
            var (nhan, css) = Fmt.Phieu(x.TrangThai);
            <tr>
                <td data-label="Phiếu">@x.Ma</td>
                <td data-label="Người lập">@x.NguoiLap.HoTen</td>
                <td data-label="Người duyệt">@(x.NguoiDuyet?.HoTen ?? "—")</td>
                <td data-label="Ngày xử lý">@(x.NgayDuyet is { } d ? Fmt.NgayGio(d) : "—")</td>
                <td data-label="Tổn thất" class="text-end">@Fmt.Tien(HuyHangService.TongTonThat(x))</td>
                <td data-label="Kết quả"><span class="badge-f @css">@nhan</span></td>
                <td class="text-end"><a asp-page="Detail" asp-route-id="@x.Id" class="btn btn-outline-primary btn-sm">Xem</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
