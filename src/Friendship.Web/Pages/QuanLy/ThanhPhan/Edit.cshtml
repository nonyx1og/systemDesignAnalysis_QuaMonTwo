@page "{id:int?}"
@model Friendship.Web.Pages.QuanLy.ThanhPhan.EditModel
@using Friendship.Domain
@{
    ViewData["Title"] = Model.IsNew ? "Thêm thành phần" : "Sửa thành phần";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<h1 class="page-title">@ViewData["Title"]</h1>

<form method="post" asp-route-id="@Model.Id" class="card-f" style="max-width:760px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label asp-for="Input.Nhom" class="form-label">Nhóm thành phần</label>
            <select asp-for="Input.Nhom" class="form-select" id="nhom-select">
                <option value="@NhomThanhPhan.COT">Cốt bánh (COT)</option>
                <option value="@NhomThanhPhan.VIEN">Viền bánh (VIEN)</option>
                <option value="@NhomThanhPhan.TOPPING">Topping trang trí (TOPPING)</option>
                <option value="@NhomThanhPhan.IN_AN">Dịch vụ in ảnh (IN_AN)</option>
            </select>
            <span asp-validation-for="Input.Nhom" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.Ten" class="form-label">Tên thành phần</label>
            <input asp-for="Input.Ten" class="form-control" />
            <span asp-validation-for="Input.Ten" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.AnhMinhHoa" class="form-label">Biểu tượng (Icon)</label>
            <select asp-for="Input.AnhMinhHoa" class="form-select">
                <option value="">— Không có icon —</option>
                @foreach (var icon in Model.Icons)
                {
                    <option value="@icon" selected="@(Model.Input.AnhMinhHoa == icon)">@icon</option>
                }
            </select>
            <span asp-validation-for="Input.AnhMinhHoa" class="text-danger"></span>
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="Input.GiaBan" class="form-label">Giá bán (₫)</label>
            <input asp-for="Input.GiaBan" type="number" step="1" min="0" class="form-control" />
            <span asp-validation-for="Input.GiaBan" class="text-danger"></span>
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="Input.SoLuongToiDa" class="form-label">Số lượng tối đa</label>
            <input asp-for="Input.SoLuongToiDa" type="number" step="1" min="1" class="form-control" />
            <span asp-validation-for="Input.SoLuongToiDa" class="text-danger"></span>
        </div>
        <div class="col-12" id="div-banh-nen" style="@(Model.Input.Nhom is NhomThanhPhan.COT or NhomThanhPhan.VIEN ? "" : "display:none")">
            <label asp-for="Input.SanPhamNenId" class="form-label">Bánh nền áp dụng <span class="text-danger">*</span></label>
            <select asp-for="Input.SanPhamNenId" class="form-select">
                <option value="">— Chọn bánh nền —</option>
                @foreach (var sp in Model.SanPhams)
                {
                    <option value="@sp.Id" selected="@(Model.Input.SanPhamNenId == sp.Id)">@sp.TenBanh (@sp.KichThuoc)</option>
                }
            </select>
            <span asp-validation-for="Input.SanPhamNenId" class="text-danger"></span>
            <div class="form-text">Cốt và viền phải gắn với một bánh nền (kích thước), vì định lượng khác nhau theo cỡ bánh.</div>
        </div>
    </div>

    <h2 class="h5 mt-4">Định lượng nguyên liệu (BOM)</h2>
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Nguyên liệu</th>
                <th style="width:170px">Định mức / 1 phần</th>
                <th style="width:60px"></th>
            </tr>
        </thead>
        <tbody id="bom" data-rows="Input.Bom">
        @for (var i = 0; i < Model.Input.Bom.Count; i++)
        {
            var dong = Model.Input.Bom[i];
            <tr data-row>
                <td>
                    <select name="Input.Bom[@i].NguyenLieuId" class="form-select" aria-label="Nguyên liệu">
                        <option value="0">— Chọn nguyên liệu —</option>
                        @foreach (var n in Model.NguyenLieus)
                        {
                            <option value="@n.NguyenLieu.Id" selected="@(dong.NguyenLieuId == n.NguyenLieu.Id)">
                                @n.NguyenLieu.TenGoi (@n.NguyenLieu.DonViTinh)
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <input name="Input.Bom[@i].DinhMuc" type="number" step="0.001" min="0.001"
                           value="@(dong.DinhMuc is null or 0 ? "" : dong.DinhMuc.Value.ToString("0.###", inv))"
                           class="form-control" aria-label="Định mức" />
                </td>
                <td>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-del-row aria-label="Xóa dòng">✕</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button type="button" class="btn btn-outline-primary btn-sm" data-add-row="#bom">+ Thêm nguyên liệu</button>

    @if (Model.GiaVon is { } gv)
    {
        <div class="alert alert-light border mt-3 mb-0">
            <strong>Giá vốn ước tính:</strong> @Fmt.Tien(gv.GiaVon) (theo đơn giá nhập của lô gần nhất).
            @if (gv.ThieuGiaNhap.Count > 0)
            {
                <div class="small text-secondary">Chưa có giá nhập cho: @string.Join(", ", gv.ThieuGiaNhap).</div>
            }
        </div>
    }

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-page="Index" class="btn btn-outline-primary">Quay lại</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            var sel = document.getElementById('nhom-select');
            var div = document.getElementById('div-banh-nen');
            if (sel && div) {
                sel.addEventListener('change', function() {
                    var v = sel.value;
                    div.style.display = (v === 'COT' || v === 'VIEN') ? '' : 'none';
                });
            }
        })();
    </script>
}
