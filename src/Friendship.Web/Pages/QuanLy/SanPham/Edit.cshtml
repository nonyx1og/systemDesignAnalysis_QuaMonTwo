@page "{id:int?}"
@model Friendship.Web.Pages.QuanLy.SanPham.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Thêm sản phẩm" : "Sửa sản phẩm"; var inv = System.Globalization.CultureInfo.InvariantCulture; }
<h1 class="page-title">@ViewData["Title"]</h1>

<form method="post" asp-route-id="@Model.Id" enctype="multipart/form-data" class="card-f" style="max-width:760px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-md-7"><label asp-for="Input.TenBanh" class="form-label">Tên bánh</label>
            <input asp-for="Input.TenBanh" class="form-control" /><span asp-validation-for="Input.TenBanh" class="text-danger"></span></div>
        <div class="col-12 col-md-5"><label asp-for="Input.KichThuoc" class="form-label">Kích thước</label>
            <input asp-for="Input.KichThuoc" class="form-control" placeholder="Cái, 18cm…" /><span asp-validation-for="Input.KichThuoc" class="text-danger"></span></div>
        <div class="col-6"><label asp-for="Input.DonGia" class="form-label">Đơn giá (₫)</label>
            <input asp-for="Input.DonGia" type="number" step="1" min="1" class="form-control" /><span asp-validation-for="Input.DonGia" class="text-danger"></span></div>
        <div class="col-6"><label asp-for="Input.HanSuDungGio" class="form-label">Hạn sử dụng (giờ)</label>
            <input asp-for="Input.HanSuDungGio" type="number" step="1" min="1" class="form-control" /><span asp-validation-for="Input.HanSuDungGio" class="text-danger"></span></div>

        <!-- Khung tải ảnh trực tiếp / Chọn ảnh sản phẩm -->
        <div class="col-12">
            <label class="form-label fw-bold">Hình ảnh sản phẩm</label>
            <input type="hidden" asp-for="Input.HinhAnh" id="inputHinhAnh" />
            <div class="d-flex flex-wrap gap-3 align-items-center p-3 bg-light rounded border">
                <div class="text-center" style="flex-shrink: 0;">
                    <div style="width: 110px; height: 110px; border-radius: 10px; overflow: hidden; border: 2px solid #e0d5cb; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
                        <img id="imgPreview" src="@(Friendship.Domain.SanPhamHinhAnhHelper.LayHinhAnh(Model.Input.TenBanh, Model.Input.HinhAnh))" alt="Xem trước hình bánh" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                    <span class="badge bg-secondary mt-1" id="lblNguonAnh" style="font-size:0.7rem;">Ảnh đang dùng</span>
                </div>
                <div style="flex: 1; min-width: 250px;">
                    <div class="mb-2">
                        <label class="form-label small text-secondary mb-1">Tải ảnh mới từ máy tính (chọn file trực tiếp, không cần nhập link):</label>
                        <input type="file" name="TepAnh" id="fileTepAnh" accept="image/png, image/jpeg, image/webp" class="form-control form-control-sm" />
                        <span asp-validation-for="TepAnh" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
                        <span class="small text-secondary me-1">Hoặc chọn ảnh mẫu tiệm:</span>
                        @foreach (var anh in Friendship.Domain.SanPhamHinhAnhHelper.DanhSachAnhMau)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.75rem;" onclick="chonAnhMau('@anh.File', '@anh.Ten')">@anh.Ten</button>
                        }
                    </div>
                    <button type="button" class="btn btn-link btn-sm text-danger p-0 mt-1" onclick="datLaiMacDinh()" style="font-size:0.8rem; text-decoration:none;">↺ Dùng ảnh tự động theo tên bánh</button>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5 mt-4">Công thức (BOM)</h2>
    <table class="table align-middle">
        <thead><tr><th>Nguyên liệu</th><th style="width:170px">Định mức / 1 bánh</th><th style="width:60px"></th></tr></thead>
        <tbody id="bom" data-rows="Input.Bom">
        @for (var i = 0; i < Model.Input.Bom.Count; i++)
        {
            var dong = Model.Input.Bom[i];
            <tr data-row>
                <td>
                    <select name="Input.Bom[@i].NguyenLieuId" class="form-select" aria-label="Nguyên liệu">
                        <option value="0">— Chọn nguyên liệu —</option>
                        @foreach (var n in Model.NguyenLieus)
                        {
                            <option value="@n.NguyenLieu.Id" selected="@(dong.NguyenLieuId == n.NguyenLieu.Id)">@n.NguyenLieu.TenGoi (@n.NguyenLieu.DonViTinh)</option>
                        }
                    </select>
                </td>
                <td><input name="Input.Bom[@i].DinhMuc" type="number" step="0.001" min="0.001" value="@(dong.DinhMuc is null or 0 ? "" : dong.DinhMuc.Value.ToString("0.###", inv))" class="form-control" aria-label="Định mức" /></td>
                <td><button type="button" class="btn btn-outline-primary btn-sm" data-del-row aria-label="Xóa dòng">✕</button></td>
            </tr>
        }
        </tbody>
    </table>
    <button type="button" class="btn btn-outline-primary btn-sm" data-add-row="#bom">+ Thêm nguyên liệu</button>

    @if (Model.GiaVon is { } gv)
    {
        <div class="alert alert-light border mt-3 mb-0">
            <strong>Giá vốn ước tính:</strong> @Fmt.Tien(gv.GiaVon)
            (theo đơn giá nhập của lô gần nhất).
            @if (Model.Input.DonGia > 0) { <span> Biên lợi nhuận: <strong>@Fmt.So(Math.Round((Model.Input.DonGia - gv.GiaVon) / Model.Input.DonGia * 100, 1))%</strong>.</span> }
            @if (gv.ThieuGiaNhap.Count > 0) { <div class="small text-secondary">Chưa có giá nhập cho: @string.Join(", ", gv.ThieuGiaNhap).</div> }
        </div>
    }

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-page="Index" class="btn btn-outline-primary">Quay lại</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var inputHinhAnh = document.getElementById('inputHinhAnh');
        var fileTepAnh = document.getElementById('fileTepAnh');
        var imgPreview = document.getElementById('imgPreview');
        var lblNguonAnh = document.getElementById('lblNguonAnh');

        fileTepAnh?.addEventListener('change', function (e) {
            var file = e.target.files && e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (evt) {
                    if (imgPreview) imgPreview.src = evt.target.result;
                    if (lblNguonAnh) {
                        lblNguonAnh.textContent = 'Ảnh tải từ máy: ' + file.name;
                        lblNguonAnh.className = 'badge bg-success mt-1';
                    }
                };
                reader.readAsDataURL(file);
            }
        });

        function chonAnhMau(path, ten) {
            if (fileTepAnh) fileTepAnh.value = '';
            if (inputHinhAnh) inputHinhAnh.value = path;
            if (imgPreview) imgPreview.src = path;
            if (lblNguonAnh) {
                lblNguonAnh.textContent = 'Mẫu: ' + ten;
                lblNguonAnh.className = 'badge bg-primary mt-1';
            }
        }

        function datLaiMacDinh() {
            if (fileTepAnh) fileTepAnh.value = '';
            if (inputHinhAnh) inputHinhAnh.value = '';
            var tenBanh = document.getElementById('Input_TenBanh') ? document.getElementById('Input_TenBanh').value.trim() : '';
            if (imgPreview) imgPreview.src = '/img/san-pham/banh-kem-sinh-nhat.jpg';
            if (lblNguonAnh) {
                lblNguonAnh.textContent = 'Tự động nhận diện';
                lblNguonAnh.className = 'badge bg-secondary mt-1';
            }
        }
    </script>
}
