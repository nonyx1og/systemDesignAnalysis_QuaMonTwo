@page
@model Friendship.Web.Pages.QuanLy.SanPham.IndexModel
@{ ViewData["Title"] = "Sản phẩm"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Sản phẩm và nguyên liệu</h1>
    <a asp-page="Edit" class="btn btn-primary">+ Thêm sản phẩm</a>
</div>
<partial name="_TabsDanhMuc" model="@("sanpham")" />

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5"><input name="Q" value="@Model.Q" class="form-control" placeholder="Tìm theo tên bánh" aria-label="Tìm kiếm" /></div>
    <div class="col-8 col-md-4">
        <select name="KinhDoanh" class="form-select" aria-label="Lọc trạng thái">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(Model.KinhDoanh == true)">Đang kinh doanh</option>
            <option value="false" selected="@(Model.KinhDoanh == false)">Đã ngừng bán</option>
        </select>
    </div>
    <div class="col-4 col-md-3"><button class="btn btn-outline-primary w-100" type="submit">Lọc</button></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card-f text-center">Chưa có sản phẩm phù hợp. <a asp-page="Edit">Thêm sản phẩm</a></div>
}
else
{
    <div class="card-f p-0">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Bánh</th><th>Kích thước</th><th class="text-end">Đơn giá</th><th class="text-end">HSD (giờ)</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var sp in Model.Items)
        {
            <tr>
                <td data-label="Bánh">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@sp.AnhHienThi" alt="@sp.TenBanh" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px; border: 1px solid #e0d5cb; flex-shrink: 0;" />
                        <div>
                            <div class="fw-semibold">@sp.TenBanh</div>
                            <div class="text-secondary small">Mã #@sp.Id</div>
                        </div>
                    </div>
                </td>
                <td data-label="Kích thước">@sp.KichThuoc</td>
                <td data-label="Đơn giá" class="text-end">@Fmt.Tien(sp.DonGia)</td>
                <td data-label="HSD (giờ)" class="text-end">@sp.HanSuDungGio</td>
                <td data-label="Trạng thái"><span class="badge-f @(sp.DangKinhDoanh ? "ok" : "danger")">@(sp.DangKinhDoanh ? "Đang kinh doanh" : "Đã ngừng bán")</span></td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@sp.Id" class="btn btn-outline-primary btn-sm">Sửa</a>
                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                        <input type="hidden" name="id" value="@sp.Id" />
                        <input type="hidden" name="kinhDoanh" value="@((!sp.DangKinhDoanh).ToString().ToLower())" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">@(sp.DangKinhDoanh ? "Ngừng bán" : "Bán lại")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
