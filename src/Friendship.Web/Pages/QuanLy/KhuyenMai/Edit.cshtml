@page "{id:int?}"
@model Friendship.Web.Pages.QuanLy.KhuyenMai.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Thêm voucher" : "Sửa voucher"; }
<h1 class="page-title">@ViewData["Title"]</h1>
<form method="post" asp-route-id="@Model.Id" class="card-f" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-md-5"><label asp-for="Input.Ma" class="form-label">Mã voucher</label>
            <input asp-for="Input.Ma" class="form-control text-uppercase" autocomplete="off" /><span asp-validation-for="Input.Ma" class="text-danger"></span></div>
        <div class="col-12 col-md-7"><label asp-for="Input.Ten" class="form-label">Tên chương trình</label>
            <input asp-for="Input.Ten" class="form-control" /><span asp-validation-for="Input.Ten" class="text-danger"></span></div>
        <div class="col-6 col-md-4"><label asp-for="Input.Loai" class="form-label">Loại giảm</label>
            <select asp-for="Input.Loai" class="form-select">
                <option value="PHAN_TRAM" selected="@(Model.Input.Loai == LoaiGiam.PHAN_TRAM)">Phần trăm (%)</option>
                <option value="SO_TIEN" selected="@(Model.Input.Loai == LoaiGiam.SO_TIEN)">Số tiền cố định (₫)</option>
            </select></div>
        <div class="col-6 col-md-4"><label asp-for="Input.GiaTri" class="form-label">Giá trị giảm</label>
            <input asp-for="Input.GiaTri" type="number" step="0.001" min="0" class="form-control" /><span asp-validation-for="Input.GiaTri" class="text-danger"></span></div>
        <div class="col-12 col-md-4"><label asp-for="Input.DonToiThieu" class="form-label">Đơn tối thiểu (₫)</label>
            <input asp-for="Input.DonToiThieu" type="number" step="1" min="0" class="form-control" /><span asp-validation-for="Input.DonToiThieu" class="text-danger"></span></div>
        <div class="col-6"><label asp-for="Input.NgayBatDau" class="form-label">Ngày bắt đầu</label>
            <input asp-for="Input.NgayBatDau" type="date" class="form-control" /><span asp-validation-for="Input.NgayBatDau" class="text-danger"></span></div>
        <div class="col-6"><label asp-for="Input.NgayKetThuc" class="form-label">Ngày kết thúc</label>
            <input asp-for="Input.NgayKetThuc" type="date" class="form-control" /><span asp-validation-for="Input.NgayKetThuc" class="text-danger"></span></div>
    </div>
    <p class="text-secondary small mt-3 mb-0">Lưu ý: voucher không áp dụng cho bánh đang giá xả hàng; điều kiện đơn tối thiểu chỉ tính trên các dòng không xả hàng (BR22). Sửa voucher chỉ ảnh hưởng đơn lập sau đó.</p>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-page="Index" class="btn btn-outline-primary">Quay lại</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
