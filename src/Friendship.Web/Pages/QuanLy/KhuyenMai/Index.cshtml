@page
@model Friendship.Web.Pages.QuanLy.KhuyenMai.IndexModel
@{ ViewData["Title"] = "Khuyến mãi"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Sản phẩm và nguyên liệu</h1>
    <a asp-page="Edit" class="btn btn-primary">+ Thêm voucher</a>
</div>
<partial name="_TabsDanhMuc" model="@("khuyenmai")" />

<form method="get" class="row g-2 mb-3">
    <div class="col-8 col-md-6"><input name="Q" value="@Model.Q" class="form-control" placeholder="Tìm theo mã hoặc tên chương trình" aria-label="Tìm kiếm" /></div>
    <div class="col-4 col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Tìm</button></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card-f text-center">Chưa có voucher. <a asp-page="Edit">Thêm voucher</a></div>
}
else
{
    <div class="card-f p-0 table-responsive">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Mã</th><th>Chương trình</th><th>Giảm</th><th class="text-end">Đơn tối thiểu</th><th>Thời hạn</th><th>Tình trạng</th><th></th></tr></thead>
        <tbody>
        @foreach (var km in Model.Items)
        {
            var (nhan, css) = Fmt.KhuyenMai(km.TinhTrang(Model.HomNay));
            <tr>
                <td data-label="Mã"><strong>@km.MaKhuyenMai</strong></td>
                <td data-label="Chương trình">@km.TenChuongTrinh</td>
                <td data-label="Giảm">@(km.LoaiGiam == LoaiGiam.PHAN_TRAM ? Fmt.So(km.GiaTriGiam) + "%" : Fmt.Tien(km.GiaTriGiam))</td>
                <td data-label="Đơn tối thiểu" class="text-end">@Fmt.Tien(km.GiaTriDonToiThieu)</td>
                <td data-label="Thời hạn">@Fmt.Ngay(km.NgayBatDau) – @Fmt.Ngay(km.NgayKetThuc)</td>
                <td data-label="Tình trạng"><span class="badge-f @css">@nhan</span></td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@km.Id" class="btn btn-outline-primary btn-sm">Sửa</a>
                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                        <input type="hidden" name="id" value="@km.Id" />
                        <input type="hidden" name="apDung" value="@((!km.DangApDung).ToString().ToLower())" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">@(km.DangApDung ? "Ngừng" : "Bật lại")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
