@page
@model Friendship.Web.Pages.QuanLy.DuyetLoi.IndexModel
@{
    ViewData["Title"] = "Duyệt phiếu báo lỗi mẻ bánh";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">Duyệt phiếu báo lỗi mẻ bánh (Bếp)</h2>
        <div class="text-secondary small">Xem xét và phê duyệt định lượng hao phí cho các mẻ bánh bị lỗi để tính vào ca bếp</div>
    </div>
    <ul class="nav nav-pills">
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "cho_duyet" ? "active" : "")" asp-page="Index" asp-route-tab="cho_duyet">
                Chờ duyệt <span class="badge bg-danger ms-1">@Model.PhieuChoDuyet.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "lich_su" ? "active" : "")" asp-page="Index" asp-route-tab="lich_su">
                Lịch sử đã xử lý
            </a>
        </li>
    </ul>
</div>

@if (Model.Tab == "cho_duyet")
{
    @if (Model.PhieuChoDuyet.Count == 0)
    {
        <div class="alert alert-success py-4 text-center">
            <div class="fs-4 mb-1">🎉</div>
            <strong>Hiện không có phiếu báo lỗi mẻ bánh nào đang chờ duyệt.</strong>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var p in Model.PhieuChoDuyet)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-warning">
                        <div class="card-header bg-warning bg-opacity-10 d-flex justify-content-between align-items-center py-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-warning text-dark fw-bold">@p.Ma</span>
                                <span class="fw-semibold">@p.CaNhanVien.Ma</span>
                                <span class="text-secondary small">· Lập lúc @p.NgayLap.ToString("HH:mm dd/MM/yyyy")</span>
                            </div>
                            <div>
                                <span class="small text-secondary">Người lập:</span> <strong>@p.NhanVienLap.HoTen</strong>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4 border-end">
                                    <div class="small text-secondary">SẢN PHẨM HỎNG:</div>
                                    <div class="h5 text-primary mb-1">@(p.SanPham?.TenBanh ?? "Bánh tùy chỉnh")</div>
                                    <div class="mb-2"><span class="badge bg-danger fs-6">Số lượng hỏng: @p.SoLuongHong bánh</span></div>
                                    <div class="small text-secondary">LÝ DO BỊ LỖI:</div>
                                    <div class="p-2 bg-light rounded small border">@p.LyDoLoi</div>
                                </div>
                                <div class="col-md-4 border-end">
                                    <div class="small text-secondary mb-2">ĐỊNH LƯỢNG NGUYÊN LIỆU HAO PHÍ:</div>
                                    <ul class="list-group list-group-flush small">
                                        @foreach (var ct in p.ChiTiets)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                                                <span>@ct.NguyenLieu.TenGoi</span>
                                                <span class="badge bg-light text-dark border fw-bold fs-6">
                                                    @ct.SoLuong.ToString("0.###") @ct.NguyenLieu.DonViTinh
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="col-md-4">
                                    <div class="small text-secondary mb-2">PHÊ DUYỆT CỦA QUẢN LÝ:</div>
                                    <form method="post" id="form-@p.Id">
                                        <div class="mb-2">
                                            <input type="text" name="ghiChu" class="form-control form-control-sm" placeholder="Ghi chú / lý do nếu từ chối..." />
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" asp-page-handler="Duyet" asp-route-id="@p.Id" class="btn btn-success btn-sm w-50 fw-bold">
                                                @Icons.Svg("check", 16) Duyệt (+Định lượng)
                                            </button>
                                            <button type="submit" asp-page-handler="TuChoi" asp-route-id="@p.Id" class="btn btn-outline-danger btn-sm w-50" onclick="return confirm('Bạn chắc chắn muốn từ chối phiếu báo lỗi này?');">
                                                @Icons.Svg("x", 16) Từ chối
                                            </button>
                                        </div>
                                    </form>
                                    <div class="text-secondary small mt-2 fst-italic">
                                        * Khi duyệt, toàn bộ nguyên liệu trên sẽ được tự động cộng vào định lượng tiêu hao của ca bếp.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0 fw-bold">Lịch sử các phiếu báo lỗi đã duyệt / từ chối</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Ca & Bếp lập</th>
                        <th>Bánh hỏng</th>
                        <th>Lý do</th>
                        <th>Nguyên liệu</th>
                        <th>Trạng thái</th>
                        <th>Người duyệt & Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PhieuLichSu.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">Chưa có lịch sử phiếu nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.PhieuLichSu)
                        {
                            <tr>
                                <td class="fw-bold">@p.Ma</td>
                                <td>
                                    <div>@p.CaNhanVien.Ma</div>
                                    <div class="small text-secondary">@p.NhanVienLap.HoTen</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(p.SanPham?.TenBanh ?? "Bánh tùy chỉnh")</div>
                                    <span class="badge bg-danger">@p.SoLuongHong bánh</span>
                                </td>
                                <td class="small">@p.LyDoLoi</td>
                                <td class="small">
                                    @foreach (var ct in p.ChiTiets)
                                    {
                                        <div>@ct.NguyenLieu.TenGoi: <strong>@ct.SoLuong.ToString("0.###")</strong> @ct.NguyenLieu.DonViTinh</div>
                                    }
                                </td>
                                <td>
                                    @if (p.TrangThai == TrangThaiPhieu.DA_DUYET)
                                    {
                                        <span class="badge bg-success">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Từ chối</span>
                                    }
                                </td>
                                <td class="small">
                                    <div class="fw-semibold">@(p.NguoiDuyet?.HoTen ?? "—")</div>
                                    <div class="text-secondary">@(p.NgayDuyet?.ToString("dd/MM/yyyy HH:mm") ?? "")</div>
                                    @if (!string.IsNullOrEmpty(p.GhiChuQuanLy))
                                    {
                                        <div class="fst-italic text-muted">@p.GhiChuQuanLy</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
