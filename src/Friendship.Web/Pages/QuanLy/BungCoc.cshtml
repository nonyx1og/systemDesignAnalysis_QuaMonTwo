@page
@model Friendship.Web.Pages.QuanLy.BungCocModel
@{ ViewData["Title"] = "Quét bùng cọc"; }
<h1 class="page-title">Quét bùng cọc</h1>
<form method="post" class="card-f" style="max-width:560px">
    <p>Đơn đặt đã làm xong (chờ giao) mà khách chưa nhận quá 24 giờ sau giờ hẹn sẽ chuyển sang <strong>bùng cọc</strong>: tiền cọc không hoàn và hệ thống lập sẵn phiếu hủy bánh (nháp) để nhân viên gửi duyệt.</p>
    <p class="text-secondary small">Nhân viên bán hàng cũng tự quét mỗi khi mở danh sách đơn.</p>
    <button type="submit" class="btn btn-primary">Quét bây giờ</button>
</form>
