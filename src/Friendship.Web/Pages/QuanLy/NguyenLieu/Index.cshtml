@page
@model Friendship.Web.Pages.QuanLy.NguyenLieu.IndexModel
@{ ViewData["Title"] = "Nguyên liệu"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Sản phẩm và nguyên liệu</h1>
    <a asp-page="Edit" class="btn btn-primary">+ Thêm nguyên liệu</a>
</div>
<partial name="_TabsDanhMuc" model="@("nguyenlieu")" />

<form method="get" class="row g-2 mb-3">
    <div class="col-8 col-md-6"><input name="Q" value="@Model.Q" class="form-control" placeholder="Tìm theo tên nguyên liệu" aria-label="Tìm kiếm" /></div>
    <div class="col-4 col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Tìm</button></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card-f text-center">Chưa có nguyên liệu phù hợp. <a asp-page="Edit">Thêm nguyên liệu</a></div>
}
else
{
    <div class="card-f p-0">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Tên</th><th>Đơn vị</th><th class="text-end">Tồn</th><th class="text-end">Mức cảnh báo</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>
                <td data-label="Tên">@x.NguyenLieu.TenGoi @if (x.DuoiMuc) { <span class="badge-f warn ms-1">Dưới mức tồn</span> }</td>
                <td data-label="Đơn vị">@x.NguyenLieu.DonViTinh</td>
                <td data-label="Tồn" class="text-end">@Fmt.So(x.TongTon)</td>
                <td data-label="Mức cảnh báo" class="text-end">@Fmt.So(x.NguyenLieu.MucCanhBaoTon)</td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@x.NguyenLieu.Id" class="btn btn-outline-primary btn-sm">Sửa</a>
                    <form method="post" asp-page-handler="Xoa" class="d-inline" onsubmit="return confirm('Xóa nguyên liệu này?');">
                        <input type="hidden" name="id" value="@x.NguyenLieu.Id" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
