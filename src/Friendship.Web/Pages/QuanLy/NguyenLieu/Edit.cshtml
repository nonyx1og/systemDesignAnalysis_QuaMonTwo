@page "{id:int?}"
@model Friendship.Web.Pages.QuanLy.NguyenLieu.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Thêm nguyên liệu" : "Sửa nguyên liệu"; }
<h1 class="page-title">@ViewData["Title"]</h1>
<form method="post" asp-route-id="@Model.Id" class="card-f" style="max-width:560px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Input.TenGoi" class="form-label">Tên nguyên liệu</label>
        <input asp-for="Input.TenGoi" class="form-control" /><span asp-validation-for="Input.TenGoi" class="text-danger"></span></div>
    <div class="row g-3">
        <div class="col-6"><label asp-for="Input.DonViTinh" class="form-label">Đơn vị tính</label>
            <input asp-for="Input.DonViTinh" class="form-control" placeholder="kg, lít, quả…" /><span asp-validation-for="Input.DonViTinh" class="text-danger"></span></div>
        <div class="col-6"><label asp-for="Input.MucCanhBaoTon" class="form-label">Mức cảnh báo tồn</label>
            <input asp-for="Input.MucCanhBaoTon" type="number" step="0.001" min="0" class="form-control" /><span asp-validation-for="Input.MucCanhBaoTon" class="text-danger"></span></div>
    </div>
    <p class="text-secondary small mt-2 mb-0">Đơn vị tính không đổi được sau khi nguyên liệu đã có lô tồn kho hoặc nằm trong công thức.</p>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-page="Index" class="btn btn-outline-primary">Quay lại</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
