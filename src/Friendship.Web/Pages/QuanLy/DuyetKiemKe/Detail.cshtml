@page "{id:int}"
@model Friendship.Web.Pages.QuanLy.DuyetKiemKe.DetailModel
@{
    var p = Model.Phieu!;
    var (nhan, css) = Fmt.Phieu(p.TrangThai);
    var lech = p.ChiTiets.Where(c => c.SoLuongThucTe != c.SoLuongHeThong).ToList();
    var tong = lech.Sum(c => (c.SoLuongThucTe - c.SoLuongHeThong) * c.LoNguyenLieu.DonGiaNhap);
    ViewData["Title"] = "Duyệt phiếu " + p.Ma;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Phiếu @p.Ma <span class="badge-f @css">@nhan</span></h1>
    <a asp-page="Index" class="btn btn-outline-primary">Quay lại</a>
</div>
<p class="text-secondary">Lập lúc @Fmt.NgayGio(p.NgayKiemKe) bởi @p.NguoiThucHien.HoTen.
    @if (!string.IsNullOrEmpty(p.LyDoTuChoi)) { <span>Lý do từ chối: <strong>@p.LyDoTuChoi</strong>.</span> }</p>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<h2 class="h5">Các dòng chênh lệch</h2>
@if (lech.Count == 0)
{
    <div class="card-f text-center mb-3">Phiếu không có dòng nào chênh lệch.</div>
}
else
{
    <div class="card-f p-0 mb-3">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Nguyên liệu</th><th>Lô</th><th class="text-end">Hệ thống</th><th class="text-end">Thực tế</th><th class="text-end">Chênh lệch</th><th class="text-end">Giá trị</th><th>Lý do</th></tr></thead>
        <tbody>
        @foreach (var c in lech)
        {
            var d = c.SoLuongThucTe - c.SoLuongHeThong;
            <tr>
                <td data-label="Nguyên liệu">@c.LoNguyenLieu.NguyenLieu.TenGoi</td>
                <td data-label="Lô">#@c.LoNguyenLieuId</td>
                <td data-label="Hệ thống" class="text-end">@Fmt.So(c.SoLuongHeThong)</td>
                <td data-label="Thực tế" class="text-end">@Fmt.So(c.SoLuongThucTe)</td>
                <td data-label="Chênh lệch" class="text-end @(d < 0 ? "text-danger" : "text-success")">@(d > 0 ? "+" : "")@Fmt.So(d) @c.LoNguyenLieu.NguyenLieu.DonViTinh</td>
                <td data-label="Giá trị" class="text-end">@Fmt.Tien(d * c.LoNguyenLieu.DonGiaNhap)</td>
                <td data-label="Lý do">@c.LyDo</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="5" class="text-end">Tổng giá trị chênh lệch</th><th class="text-end">@Fmt.Tien(tong)</th><th></th></tr></tfoot>
    </table>
    </div>
}

@if (p.TrangThai == TrangThaiPhieu.CHO_DUYET)
{
    <div class="row g-3">
        <div class="col-12 col-md-5">
            <form method="post" asp-page-handler="Duyet" onsubmit="return confirm('Duyệt phiếu? Tồn kho sẽ được cộng chênh lệch.');">
                <button type="submit" class="btn btn-primary w-100">Duyệt phiếu</button>
            </form>
        </div>
        <div class="col-12 col-md-7">
            <form method="post" asp-page-handler="TuChoi" class="input-group">
                <input name="lyDo" class="form-control" placeholder="Lý do từ chối (bắt buộc)" aria-label="Lý do từ chối" />
                <button type="submit" class="btn btn-outline-primary">Từ chối</button>
            </form>
        </div>
    </div>
}
