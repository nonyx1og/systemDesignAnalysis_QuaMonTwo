@page
@model Friendship.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<h1 class="page-title">Đổi mật khẩu</h1>
<form method="post" class="card-f" style="max-width:480px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="MatKhauCu" class="form-label">Mật khẩu hiện tại</label>
        <input asp-for="MatKhauCu" type="password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="MatKhauCu" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MatKhauMoi" class="form-label">Mật khẩu mới (≥ 8 ký tự)</label>
        <input asp-for="MatKhauMoi" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NhapLai" class="form-label">Nhập lại mật khẩu mới</label>
        <input asp-for="NhapLai" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NhapLai" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu mật khẩu</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
