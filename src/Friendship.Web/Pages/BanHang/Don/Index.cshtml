@page
@model Friendship.Web.Pages.BanHang.Don.IndexModel
@{ ViewData["Title"] = "Đơn hàng"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Đơn hàng</h1>
    <div class="d-flex gap-2">
        <a asp-page="/BanHang/BanLe" class="btn btn-primary">Bán lẻ</a>
        <a asp-page="/BanHang/DonDat" class="btn btn-outline-primary">+ Đơn đặt</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5"><input name="Q" value="@Model.Q" class="form-control" placeholder="Mã đơn, số điện thoại hoặc tên khách" aria-label="Tìm kiếm" /></div>
    <div class="col-6 col-md-3">
        <select name="TrangThai" class="form-select" aria-label="Trạng thái">
            <option value="">Mọi trạng thái</option>
            @foreach (var t in Enum.GetValues<TrangThaiDon>())
            {
                <option value="@t" selected="@(Model.TrangThai == t)">@Fmt.Don(t).Nhan</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select name="Loai" class="form-select" aria-label="Loại đơn">
            <option value="">Mọi loại</option>
            <option value="DAT_TRUOC" selected="@(Model.Loai == LoaiDon.DAT_TRUOC)">Đặt trước</option>
            <option value="BAN_LE" selected="@(Model.Loai == LoaiDon.BAN_LE)">Bán lẻ</option>
        </select>
    </div>
    <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Tìm</button></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card-f text-center">Không có đơn nào.</div>
}
else
{
    <div class="card-f p-0">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Mã</th><th>Loại</th><th>Khách</th><th>Giờ hẹn</th><th class="text-end">Tổng</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.Items)
        {
            var (nhan, css) = Fmt.Don(d.TrangThai);
            <tr>
                <td data-label="Mã"><strong>@d.Ma</strong></td>
                <td data-label="Loại">@(d.LoaiDon == LoaiDon.DAT_TRUOC ? "Đặt trước" : "Bán lẻ")</td>
                <td data-label="Khách">@(d.KhachHang is null ? "—" : d.KhachHang.TenKhachHang + " · " + d.KhachHang.SoDienThoai)</td>
                <td data-label="Giờ hẹn">@(d.NgayGioLay is { } g ? Fmt.NgayGio(g) : "—")</td>
                <td data-label="Tổng" class="text-end">@Fmt.Tien(d.TongThanhToan)</td>
                <td data-label="Trạng thái"><span class="badge-f @css">@nhan</span></td>
                <td class="text-end"><a asp-page="Details" asp-route-id="@d.Id" class="btn btn-outline-primary btn-sm">Xem</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
