@page
@model Friendship.Web.Pages.BanHang.CocOnlineModel
@using Friendship.Domain
@{
    ViewData["Title"] = "Xác nhận cọc online";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">💳 Xác nhận cọc bánh tùy chỉnh</h2>
        <span class="text-muted small">Danh sách các thiết kế đã được bếp duyệt &amp; báo giá đang chờ khách chuyển khoản cọc</span>
    </div>
    <span class="badge bg-info text-dark fs-6 px-3 py-2">@Model.Items.Count thiết kế chờ cọc</span>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.CoCa)
{
    <div class="alert alert-warning mb-4" role="alert">
        <strong>⚠️ Bạn chưa mở ca thu ngân!</strong> Hãy <a href="/BanHang/Ca/Index" class="alert-link">mở ca tại đây</a> trước khi nhận tiền cọc.
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">
        <div class="display-6 mb-2">🍃</div>
        <h5>Hiện không có thiết kế nào đang chờ cọc.</h5>
        <p class="small mb-0">Khi bếp duyệt thiết kế và gửi báo giá cho khách, thiết kế sẽ xuất hiện tại đây.</p>
    </div>
}
else
{
    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">Ảnh</th>
                    <th>Mã tra cứu</th>
                    <th>Khách hàng</th>
                    <th>Hẹn lấy bánh</th>
                    <th class="text-end">Giá cuối</th>
                    <th class="text-center" style="width: 280px;">Xác nhận nhận cọc</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tk in Model.Items)
                {
                    var khoang = CocRule.Khoang(tk.GiaCuoi);
                    <tr>
                        <td>
                            <img src="/dat/anh/@tk.MaTraCuu/thiet-ke" alt="Mẫu bánh" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" />
                        </td>
                        <td>
                            <span class="font-monospace fw-bold text-primary">@tk.MaTraCuu</span>
                            <div class="small text-muted">Nội dung CK: <strong class="text-danger font-monospace">@tk.Ma</strong></div>
                        </td>
                        <td>
                            <div class="fw-semibold">@tk.KhachHang.TenKhachHang</div>
                            <div class="small text-muted font-monospace">@tk.KhachHang.SoDienThoai</div>
                        </td>
                        <td>
                            <div class="fw-bold text-danger">@tk.NgayGioLay.ToString("dd/MM/yyyy HH:mm")</div>
                            @if (tk.HanBaoGia.HasValue)
                            {
                                <div class="small text-muted">Hạn cọc: @tk.HanBaoGia.Value.ToString("dd/MM HH:mm")</div>
                            }
                        </td>
                        <td class="text-end">
                            <h5 class="fw-bold text-success mb-0">@tk.GiaCuoi.ToString("N0") đ</h5>
                            <div class="small text-muted">Cọc: @khoang.Min.ToString("N0") - @khoang.Max.ToString("N0") đ</div>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="XacNhan" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="ThietKeId" value="@tk.Id" />
                                <div class="input-group input-group-sm">
                                    <input type="number" name="TienCoc" value="@khoang.Min" min="@khoang.Min" max="@khoang.Max" step="1000" class="form-control" required @(Model.CoCa ? "" : "disabled") />
                                    <span class="input-group-text">₫</span>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary text-nowrap fw-semibold" @(Model.CoCa ? "" : "disabled")>
                                    Đã nhận cọc
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
