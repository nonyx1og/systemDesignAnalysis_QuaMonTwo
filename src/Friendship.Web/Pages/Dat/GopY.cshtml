@page
@model Friendship.Web.Pages.Dat.GopYModel
@using Friendship.Web
@{
    ViewData["Title"] = "Góp ý & Đánh giá cho tiệm";
}

<div class="dat-feedback-page" style="margin: 2rem 0 4rem;">
    <!-- Tiêu đề trang -->
    <header style="text-align: center; max-width: 640px; margin: 0 auto 2.5rem;">
        <span style="display: inline-block; padding: 0.35rem 0.85rem; background: var(--dat-berry-light); color: var(--dat-berry); font-weight: 700; border-radius: 999px; font-size: 0.8125rem; margin-bottom: 0.75rem;">
            LẮNG NGHE & HOÀN THIỆN
        </span>
        <h1 class="dat-h1" style="font-size: 2.25rem; margin-bottom: 0.75rem;">Góp ý & Đánh giá cho tiệm</h1>
        <p class="dat-lead" style="font-size: 1.0625rem; color: var(--dat-text-secondary);">
            Mỗi ý kiến đóng góp của bạn là động lực to lớn giúp FrendshipBakery cải tiến công thức bánh và dịch vụ chăm sóc khách hàng ngày một tốt hơn.
        </p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start;">
        <!-- Form gửi góp ý -->
        <section class="dat-paper" style="padding: 2.25rem 2rem; border-radius: 12px;">
            <h2 class="dat-h2" style="font-size: 1.375rem; margin-bottom: 1.25rem; color: var(--dat-text-main);">
                Gửi phản hồi của bạn
            </h2>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="dat-flash dat-flash-err mb-3" role="alert"></div>

                <!-- Đánh giá mức độ hài lòng (sao) -->
                <div class="mb-3">
                    <label class="form-label" style="font-weight: 600; color: var(--dat-text-main); display: block;">
                        Mức độ hài lòng của bạn <span style="color:var(--dat-berry);">*</span>
                    </label>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        @for (int s = 5; s >= 1; s--)
                        {
                            <label style="display: flex; align-items: center; gap: 0.35rem; background: var(--dat-bg-canvas); border: 1px solid var(--dat-champagne); border-radius: 999px; padding: 0.35rem 0.85rem; font-size: 0.875rem; cursor: pointer;">
                                <input type="radio" asp-for="DiemDanhGia" value="@s" />
                                <span>@string.Concat(Enumerable.Repeat("⭐", s)) (@(s == 5 ? "Tuyệt vời" : s == 4 ? "Hài lòng" : s == 3 ? "Bình thường" : s == 2 ? "Chưa tốt" : "Rất tệ"))</span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="DiemDanhGia" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="HoTen" class="form-label" style="font-weight: 600; color: var(--dat-text-main);">Họ và tên <span style="color:var(--dat-berry);">*</span></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Tên của bạn" style="background:#fff; border-color:var(--dat-champagne);" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="SoDienThoai" class="form-label" style="font-weight: 600; color: var(--dat-text-main);">Số điện thoại <span style="color:var(--dat-berry);">*</span></label>
                        <input asp-for="SoDienThoai" type="tel" class="form-control" placeholder="Để tiệm phản hồi" style="background:#fff; border-color:var(--dat-champagne);" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label" style="font-weight: 600; color: var(--dat-text-main);">Email (tùy chọn)</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Email nhận phản hồi" style="background:#fff; border-color:var(--dat-champagne);" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TieuDe" class="form-label" style="font-weight: 600; color: var(--dat-text-main);">Chủ đề góp ý <span style="color:var(--dat-berry);">*</span></label>
                    <input asp-for="TieuDe" class="form-control" placeholder="Ví dụ: Hương vị bánh kem bắp, Thời gian giao hàng, Đóng gói hộp..." style="background:#fff; border-color:var(--dat-champagne);" />
                    <span asp-validation-for="TieuDe" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NoiDung" class="form-label" style="font-weight: 600; color: var(--dat-text-main);">Nội dung chi tiết <span style="color:var(--dat-berry);">*</span></label>
                    <textarea asp-for="NoiDung" rows="4" class="form-control" placeholder="Chia sẻ cảm nhận, ý kiến hoặc đề xuất của bạn dành cho tiệm bánh..." style="background:#fff; border-color:var(--dat-champagne);"></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger small"></span>
                </div>

                <button type="submit" class="dat-btn dat-btn-primary w-100" style="padding: 0.75rem; font-size: 1.0625rem; font-weight: 600;">
                    Gửi góp ý ngay
                </button>
            </form>
        </section>

        <!-- Cảm nhận của khách hàng khác -->
        <aside>
            <div class="dat-paper" style="padding: 1.75rem; border-radius: 12px; margin-bottom: 1.5rem;">
                <h3 class="dat-h3" style="font-size: 1.125rem; margin-bottom: 0.75rem; color: var(--dat-text-main);">
                    Cam kết chất lượng từ FrendshipBakery
                </h3>
                <ul style="padding-left: 1.25rem; margin: 0; color: var(--dat-text-secondary); font-size: 0.9375rem; line-height: 1.6;">
                    <li>100% bánh mới nướng trong ngày, không sử dụng chất bảo quản.</li>
                    <li>Sử dụng bơ lạt động vật và whipping cream nguyên chất từ New Zealand.</li>
                    <li>Giao bánh đúng giờ đã hẹn hoặc giữ lạnh đạt chuẩn khi lấy tại quầy.</li>
                    <li>Mọi thắc mắc và khiếu nại đều được xử lý và phản hồi trong 24 giờ.</li>
                </ul>
            </div>

            @if (Model.DanhSachGopY.Count > 0)
            {
                <h3 class="dat-h3" style="font-size: 1.125rem; margin: 1.5rem 0 1rem; color: var(--dat-text-main);">
                    Đánh giá từ khách hàng yêu mến tiệm
                </h3>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var g in Model.DanhSachGopY)
                    {
                        <div class="dat-paper" style="padding: 1.25rem; border-radius: 8px; background: #fff;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                <strong style="color: var(--dat-text-main); font-size: 0.9375rem;">@g.HoTen</strong>
                                <span style="font-size: 0.8125rem; color: #ffb800;">@string.Concat(Enumerable.Repeat("★", g.DiemDanhGia))</span>
                            </div>
                            <div style="font-size: 0.875rem; font-weight: 600; color: var(--dat-berry); margin-bottom: 0.25rem;">
                                @g.TieuDe
                            </div>
                            <p style="font-size: 0.8125rem; color: var(--dat-text-secondary); margin: 0; line-height: 1.45;">
                                “@g.NoiDung”
                            </p>
                            <span style="font-size: 0.75rem; color: var(--dat-text-muted); display: block; margin-top: 0.4rem;">
                                Ngày @g.NgayGui.ToString("dd/MM/yyyy")
                            </span>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
