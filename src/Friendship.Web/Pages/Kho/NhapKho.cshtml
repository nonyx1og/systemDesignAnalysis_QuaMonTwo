@page
@model Friendship.Web.Pages.Kho.NhapKhoModel
@{ ViewData["Title"] = "Nhập kho"; var inv = System.Globalization.CultureInfo.InvariantCulture; }
<h1 class="page-title">Nhập kho nguyên liệu</h1>

<form method="post" class="card-f mb-4" onsubmit="document.querySelectorAll('button[type=submit]').forEach(function (b) { setTimeout(function () { b.disabled = true; }, 0); });">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Nguyên liệu</th><th style="width:140px">Số lượng</th><th style="width:150px">Đơn giá nhập (₫)</th><th style="width:170px">Hạn sử dụng</th><th style="width:60px"></th></tr></thead>
        <tbody id="dong" data-rows="Rows">
        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var r = Model.Rows[i];
            <tr data-row>
                <td>
                    <select name="Rows[@i].NguyenLieuId" class="form-select" aria-label="Nguyên liệu">
                        <option value="0">— Chọn nguyên liệu —</option>
                        @foreach (var n in Model.NguyenLieus)
                        {
                            <option value="@n.NguyenLieu.Id" selected="@(r.NguyenLieuId == n.NguyenLieu.Id)">@n.NguyenLieu.TenGoi (@n.NguyenLieu.DonViTinh)</option>
                        }
                    </select>
                </td>
                <td><input name="Rows[@i].SoLuong" type="number" step="0.001" min="0.001" value="@(r.SoLuong is null or 0 ? "" : r.SoLuong.Value.ToString("0.###", inv))" class="form-control" aria-label="Số lượng" /></td>
                <td><input name="Rows[@i].DonGia" type="number" step="1" min="1" value="@(r.DonGia is null or 0 ? "" : r.DonGia.Value.ToString("0.###", inv))" class="form-control" aria-label="Đơn giá nhập" /></td>
                <td><input name="Rows[@i].HanSuDung" type="date" value="@(r.HanSuDung?.ToString("yyyy-MM-dd"))" class="form-control" aria-label="Hạn sử dụng" /></td>
                <td><button type="button" class="btn btn-outline-primary btn-sm" data-del-row aria-label="Xóa dòng">✕</button></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <button type="button" class="btn btn-outline-primary btn-sm" data-add-row="#dong">+ Thêm dòng</button>
    <div class="mt-3"><button type="submit" class="btn btn-primary">Lưu nhập kho</button></div>
</form>

<h2 class="h5">Tồn hiện tại</h2>
<div class="card-f p-0">
<table class="table table-cards align-middle mb-0">
    <thead><tr><th>Nguyên liệu</th><th>Đơn vị</th><th class="text-end">Tồn</th><th class="text-end">Mức cảnh báo</th></tr></thead>
    <tbody>
    @foreach (var n in Model.NguyenLieus)
    {
        <tr>
            <td data-label="Nguyên liệu">@n.NguyenLieu.TenGoi @if (n.DuoiMuc) { <span class="badge-f warn ms-1">Dưới mức tồn</span> }</td>
            <td data-label="Đơn vị">@n.NguyenLieu.DonViTinh</td>
            <td data-label="Tồn" class="text-end">@Fmt.So(n.TongTon)</td>
            <td data-label="Mức cảnh báo" class="text-end">@Fmt.So(n.NguyenLieu.MucCanhBaoTon)</td>
        </tr>
    }
    </tbody>
</table>
</div>
