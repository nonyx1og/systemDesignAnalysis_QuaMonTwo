@page
@model Friendship.Web.Pages.Admin.TaiKhoan.IndexModel
@{ ViewData["Title"] = "Tài khoản"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Tài khoản và phân quyền</h1>
    <a asp-page="Edit" class="btn btn-primary">+ Thêm tài khoản</a>
</div>

@if (Model.Items.Any(x => x.DangHoatDong))
{
    <div class="card-f mb-3 p-3" style="background: #fffaf5; border: 1px solid #fbd5b5; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div>
                <strong class="d-flex align-items-center gap-1" style="font-size: 1rem; color: #7c2d12;">
                    ⚡ Đăng nhập nhanh các tài khoản (Chuyển quyền một chạm)
                </strong>
                <span class="text-secondary small">Admin có thể bấm trực tiếp vào tài khoản bên dưới để đăng nhập ngay mà không cần mật khẩu:</span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 pt-1">
            @foreach (var nv in Model.Items.Where(x => x.DangHoatDong))
            {
                var isCurrent = nv.Id == User.NhanVienId();
                var icon = nv.VaiTro switch {
                    VaiTro.QUAN_TRI => "👑",
                    VaiTro.QUAN_LY => "💼",
                    VaiTro.BAN_HANG => "🛒",
                    VaiTro.SAN_XUAT => "🎂",
                    VaiTro.KHO => "📦",
                    _ => "👤"
                };
                <form method="post" asp-page-handler="DangNhapNhanh" class="d-inline">
                    <input type="hidden" name="id" value="@nv.Id" />
                    <button type="submit" class="btn btn-sm @(isCurrent ? "btn-success disabled" : "btn-outline-dark") d-flex align-items-center gap-1"
                            style="border-radius: 20px; padding: 0.35rem 0.85rem;"
                            title="Đăng nhập ngay dưới tài khoản @nv.HoTen (@nv.TenDangNhap)">
                        <span>@icon</span>
                        <strong>@nv.HoTen</strong>
                        <span class="badge @(isCurrent ? "bg-light text-dark" : "bg-secondary text-white")" style="font-size: 0.7rem; font-weight: 500;">
                            @nv.VaiTro.TenHienThi()
                        </span>
                        @if (isCurrent)
                        {
                            <span style="font-size: 0.75rem;">(Đang dùng)</span>
                        }
                    </button>
                </form>
            }
        </div>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5"><input name="Q" value="@Model.Q" class="form-control" placeholder="Tìm theo tên, tên đăng nhập, SĐT" aria-label="Tìm kiếm" /></div>
    <div class="col-8 col-md-4">
        <select name="Role" class="form-select" aria-label="Lọc vai trò">
            <option value="">Tất cả vai trò</option>
            @foreach (var v in Enum.GetValues<VaiTro>())
            {
                <option value="@v" selected="@(Model.Role == v)">@v.TenHienThi()</option>
            }
        </select>
    </div>
    <div class="col-4 col-md-3"><button class="btn btn-outline-primary w-100" type="submit">Lọc</button></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card-f text-center">Không có tài khoản phù hợp. <a asp-page="Edit">Thêm tài khoản</a></div>
}
else
{
    <div class="card-f p-0">
    <table class="table table-cards align-middle mb-0">
        <thead><tr><th>Họ tên</th><th>Tên đăng nhập</th><th>Vai trò</th><th>SĐT</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var nv in Model.Items)
        {
            <tr>
                <td data-label="Họ tên">@nv.HoTen</td>
                <td data-label="Tên đăng nhập">@nv.TenDangNhap</td>
                <td data-label="Vai trò">@nv.VaiTro.TenHienThi()</td>
                <td data-label="SĐT">@nv.SoDienThoai</td>
                <td data-label="Trạng thái"><span class="badge-f @(nv.DangHoatDong ? "ok" : "danger")">@(nv.DangHoatDong ? "Hoạt động" : "Đã khóa")</span></td>
                <td class="text-end">
                    @if (nv.Id != User.NhanVienId() && nv.DangHoatDong)
                    {
                        <form method="post" asp-page-handler="DangNhapNhanh" class="d-inline me-1">
                            <input type="hidden" name="id" value="@nv.Id" />
                            <button type="submit" class="btn btn-success btn-sm" title="Đăng nhập ngay dưới tài khoản @nv.TenDangNhap">
                                ⚡ Đăng nhập
                            </button>
                        </form>
                    }
                    <a asp-page="Edit" asp-route-id="@nv.Id" class="btn btn-outline-primary btn-sm">Sửa</a>
                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                        <input type="hidden" name="id" value="@nv.Id" />
                        <input type="hidden" name="active" value="@((!nv.DangHoatDong).ToString().ToLower())" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">@(nv.DangHoatDong ? "Khóa" : "Mở khóa")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
