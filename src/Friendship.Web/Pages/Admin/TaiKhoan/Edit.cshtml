@page "{id:int?}"
@model Friendship.Web.Pages.Admin.TaiKhoan.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Thêm tài khoản" : "Sửa tài khoản"; }
<h1 class="page-title">@ViewData["Title"]</h1>

<form method="post" asp-route-id="@Model.Id" class="card-f mb-4" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="Input.HoTen" class="form-label">Họ tên</label>
            <input asp-for="Input.HoTen" class="form-control" /><span asp-validation-for="Input.HoTen" class="text-danger"></span></div>
        <div class="col-6"><label asp-for="Input.GioiTinh" class="form-label">Giới tính</label>
            <select asp-for="Input.GioiTinh" class="form-select"><option value="">—</option><option>Nam</option><option>Nữ</option></select></div>
        <div class="col-6"><label asp-for="Input.NgaySinh" class="form-label">Ngày sinh</label>
            <input asp-for="Input.NgaySinh" type="date" class="form-control" /></div>
        <div class="col-12 col-md-6"><label asp-for="Input.SoDienThoai" class="form-label">Số điện thoại</label>
            <input asp-for="Input.SoDienThoai" class="form-control" inputmode="tel" /><span asp-validation-for="Input.SoDienThoai" class="text-danger"></span></div>
        <div class="col-12 col-md-6"><label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
        <div class="col-12 col-md-6"><label asp-for="Input.TenDangNhap" class="form-label">Tên đăng nhập</label>
            <input asp-for="Input.TenDangNhap" class="form-control" autocomplete="off" /><span asp-validation-for="Input.TenDangNhap" class="text-danger"></span></div>
        <div class="col-12 col-md-6"><label asp-for="Input.VaiTro" class="form-label">Vai trò</label>
            <select asp-for="Input.VaiTro" class="form-select">
                @foreach (var v in Enum.GetValues<VaiTro>()) { <option value="@v" selected="@(Model.Input.VaiTro == v)">@v.TenHienThi()</option> }
            </select></div>
        @if (Model.IsNew)
        {
            <div class="col-12"><label asp-for="MatKhauTam" class="form-label">Mật khẩu tạm (≥ 8 ký tự)</label>
                <input asp-for="MatKhauTam" type="text" class="form-control" autocomplete="off" /></div>
        }
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-page="Index" class="btn btn-outline-primary">Quay lại</a>
    </div>
</form>

@if (!Model.IsNew)
{
    <form method="post" asp-page-handler="Reset" asp-route-id="@Model.Id" class="card-f" style="max-width:640px">
        <h2 class="h5">Đặt lại mật khẩu</h2>
        <div class="input-group">
            <input name="matKhauMoi" class="form-control" placeholder="Mật khẩu mới (≥ 8 ký tự)" aria-label="Mật khẩu mới" autocomplete="off" />
            <button type="submit" class="btn btn-outline-primary">Đặt lại</button>
        </div>
    </form>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
